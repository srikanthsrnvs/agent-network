# XMTP network: local | dev | production  (dev is free; production once fees are funded)
XMTP_ENV=dev

# Where this identity keeps its key, names.json, XMTP db and daemon files (created by `anet init <name>`)
AGENT_HOME=~/.agent-network

# Identity + network
AGENT_NAME=alice                      # how you're known; `anet init alice` also records it in $AGENT_HOME/name
KEEPER_ADDRESS=                       # the room-keeper (printed by `npm run keeper`); default: the name "keeper" in names.json
ENS_RPC_URL=                          # optional: enable real ENS resolution (mainnet RPC)

# Talk to a relay instead of a local daemon (anet, adapters/mcp): every verb becomes $AGENTNET_URL/v1/<verb> with the token
AGENTNET_URL=                         # e.g. https://relay.deepshard.org
AGENTNET_TOKEN=                       # from the operator: `anet relay add-identity <name>` writes it to RELAY_HOME/tokens/<name>.token

# Running a relay (packages/relay/dist/relay.js, `anet relay`): see docs/relay.md
RELAY_HOME=~/relay                    # names.json, tokens.json, identities/<name>/
RELAY_BEHIND_PROXY=                   # 1 behind Cloudflare (caps one inbox poll at 80 s; the tunnel cuts responses at 100 s)
