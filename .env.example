# Model access for the device agent (any OpenRouter model id)
OPENROUTER_API_KEY=
AGENT_MODEL=anthropic/claude-sonnet-4.6

# XMTP network: local | dev | production  (dev is free; production once fees are funded)
XMTP_ENV=dev

# Where the device keeps its key + XMTP db (generated on first boot if absent)
AGENT_HOME=~/.agent-network

# Identity + network
AGENT_NAME=alice.agent.eth            # how you're known (a local contacts file maps names → addresses for now)
KEEPER_ADDRESS=                       # printed by `npm run keeper`
AGENT_INSTRUCTIONS=                   # optional plain-language standing instructions from the owner
ENS_RPC_URL=                          # optional: enable real ENS resolution (mainnet RPC)
AGENT_DEBUG=                          # set to 1 to log tool calls
