# XMTP network: local | dev | production  (dev is free; production once fees are funded)
XMTP_ENV=dev

# Where this identity keeps its key, names.json, XMTP db and daemon files (created by `anet init <name>`)
AGENT_HOME=~/.agent-network

# Identity + network
AGENT_NAME=alice                      # how you're known; `anet init alice` also records it in $AGENT_HOME/name
KEEPER_ADDRESS=                       # the room-keeper (printed by `npm run keeper`); default: the name "keeper" in names.json
ENS_RPC_URL=                          # optional: enable real ENS resolution (mainnet RPC)
