#!/usr/bin/env python3
"""sc — run a shell command inside the codex sandbox on the Threadripper, over the HTTPS gateway.

Usage:  codex/bin/sc '<cmd ...>'                 all args are joined by spaces into one bash command
        codex/bin/sc --upload <local-file> <remote-path>   ship a file into the sandbox (/swarm/me/..., /swarm/shared/..., /tmp/...)
Env:    SWARM_GATEWAY_HOST   e.g. words-words-words.trycloudflare.com   (required)
        CODEX_GATEWAY_TOKEN  bearer token for the "codex" sandbox          (required, secret)
        SC_TIMEOUT           remote timeout in seconds (default 600, max 3600)
Each call is ONE HTTPS POST: the gateway runs `bash -lc <cmd>` in swarm-codex (cwd /swarm/me/work, user agent) and
returns exit code, stdout, stderr. stdout/stderr are relayed, the exit code becomes this process's exit code
(124 = remote timeout). Network/gateway failures are retried 3 times with 15 s pauses, then exit 255.
Long jobs: codex/bin/sc "tmux new -d -s <job> '<command>'" and poll the log with sc. stdlib only.
"""
import json, os, sys, time, urllib.error, urllib.request

ATTEMPTS, PAUSE = 4, 15   # 1 try + 3 retries


def die(msg, code=255):
    sys.stderr.write(f"sc: {msg}\n"); sys.stderr.flush(); sys.exit(code)


def env():
    host, tok = os.environ.get("SWARM_GATEWAY_HOST", "").strip(), os.environ.get("CODEX_GATEWAY_TOKEN", "").strip()
    if not host or not tok:
        die("SWARM_GATEWAY_HOST and CODEX_GATEWAY_TOKEN must be set (see codex/README.md)", 2)
    host = host.replace("https://", "").replace("http://", "").rstrip("/")
    return host, tok


def post(path, body, timeout):
    host, tok = env()
    data = json.dumps(body).encode()
    req = urllib.request.Request(f"https://{host}{path}", data=data, method="POST",
                                 headers={"Authorization": f"Bearer {tok}", "Content-Type": "application/json"})
    last = None
    for attempt in range(1, ATTEMPTS + 1):
        try:
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return json.loads(r.read().decode("utf-8", "replace"))
        except urllib.error.HTTPError as e:
            if e.code in (400, 401, 404, 413):   # our own request is wrong; retrying will not help
                die(f"gateway answered HTTP {e.code}: {e.read().decode('utf-8', 'replace')[:300]}", 255)
            last = f"HTTP {e.code} from gateway/tunnel"
        except (urllib.error.URLError, TimeoutError, OSError, ValueError) as e:
            last = f"{type(e).__name__}: {e}"
        if attempt < ATTEMPTS:
            sys.stderr.write(f"sc: {last}; retry {attempt}/{ATTEMPTS - 1} in {PAUSE}s\n"); sys.stderr.flush()
            time.sleep(PAUSE)
    die(f"the gateway is unreachable ({last}); the tunnel may be down or SWARM_GATEWAY_HOST stale "
        f"(current hostname lives in ~/swarm/codex/GATEWAY on the box)")


def main(argv):
    if not argv or argv == ["-h"] or argv == ["--help"]:
        sys.stderr.write(__doc__); sys.exit(2)
    if argv[0] == "--upload":
        if len(argv) != 3:
            die("usage: sc --upload <local-file> <remote-path>", 2)
        local, remote = argv[1], argv[2]
        try:
            content = open(local, "rb").read().decode("utf-8")
        except UnicodeDecodeError:
            die("upload is for text files (UTF-8); for binaries use base64 through sc", 2)
        except OSError as e:
            die(f"cannot read {local}: {e}", 2)
        mode = "0755" if os.access(local, os.X_OK) else "0644"
        res = post("/upload", {"path": remote, "content": content, "mode": mode}, timeout=120)
        if not res.get("ok"):
            die(f"upload failed: {res}", 1)
        print(f"uploaded {res.get('bytes')} bytes to {remote} (mode {mode})"); return 0
    cmd = " ".join(argv)
    try:
        timeout = max(1, min(int(os.environ.get("SC_TIMEOUT") or 600), 3600))
    except ValueError:
        die("SC_TIMEOUT must be an integer number of seconds", 2)
    res = post("/exec", {"cmd": cmd, "timeout": timeout}, timeout=timeout + 60)
    out, err = res.get("stdout", ""), res.get("stderr", "")
    if out:
        sys.stdout.write(out); sys.stdout.flush()
    if err:
        sys.stderr.write(err); sys.stderr.flush()
    code = res.get("exit", 1)
    return code if isinstance(code, int) and 0 <= code <= 255 else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
