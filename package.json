{
  "name": "agent-network",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "adapters/mcp",
    "tools/observer"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "keeper": "tsx packages/keeper/src/main.ts",
    "observer": "tsx tools/observer/src/main.ts",
    "cli": "node packages/cli/bin/anet.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "@xmtp/node-sdk": "6.1.0"
  }
}
